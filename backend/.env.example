# ============================================================================
# Backend Environment Variables Template
# Copy this file to .env and fill in with your actual values
# NEVER commit the actual .env file - it contains secrets!
# ============================================================================

# ============================================================================
# DEBUG & SECURITY
# ============================================================================
DEBUG=True
SECRET_KEY=django-insecure-replace-with-a-strong-secret-key-in-production
DJANGO_SETTINGS_MODULE=config.settings.development

# ============================================================================
# DATABASE (PostgreSQL recommended for production)
# ============================================================================
# Local development (outside Docker)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5434/pdf_ia_rework_db

# Docker development (inside Docker)
# DATABASE_URL=postgresql://postgres:postgres123@db:5432/pdf_ia_rework_db

# SQLite (for quick testing only - NOT recommended)
# DATABASE_URL=sqlite:///db.sqlite3

# ============================================================================
# DJANGO
# ============================================================================
ALLOWED_HOSTS=localhost,127.0.0.1,127.0.0.1:8000,127.0.0.1:8001
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ============================================================================
# CORS (Frontend Communication)
# ============================================================================
# Must match your frontend domain exactly!
# Development: http://localhost:5173 (Vite default)
# Production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ============================================================================
# LLM / AI SERVICES (REQUIRED)
# ============================================================================
# Groq API Key - Get from https://console.groq.com/keys
# Required for chat/AI functionality
GROQ_API_KEY=gsk_your-groq-api-key-here

# Groq Model Configuration (Fase 6: Configurable)
# Available models: https://console.groq.com/docs/models
# Default: llama-3.1-8b-instant (fast & accurate)
GROQ_MODEL=llama-3.1-8b-instant

# Maximum tokens per response (context window limit)
# Higher values = longer responses but slower and more tokens used
GROQ_MAX_TOKENS=1024

# Temperature (0.0 = deterministic, 1.0 = creative)
# 0.7 is recommended balance
GROQ_TEMPERATURE=0.7

# ============================================================================
# DOCUMENT PROCESSING & RAG (Fase 6: Mejora STEP 3)
# ============================================================================
# Maximum characters per document in RAG context
# Higher = more info but might exceed token limits
DOCUMENT_MAX_CHARS_PER_DOC=1500

# Maximum total characters in entire RAG context
# Overall limit to prevent token overflow
DOCUMENT_MAX_CHARS_TOTAL=5000

# Enable semantic search for relevant document chunks
# False = simple truncation, True = intelligent chunking + relevance ranking
DOCUMENT_ENABLE_SEMANTIC_SEARCH=True

# Chunk size for splitting long documents
# Smaller = more chunks to search, Larger = fewer but longer chunks
DOCUMENT_CHUNK_SIZE=500

# Overlap between chunks for context preservation
# Prevents losing information at chunk boundaries
DOCUMENT_CHUNK_OVERLAP=50

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ============================================================================
# AWS S3 / STORAGE (Optional - for production file uploads)
# ============================================================================
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1

# ============================================================================
# LOGGING (Optional - for debugging)
# ============================================================================
# LOG_LEVEL=INFO
# SENTRY_DSN=

# ============================================================================
# DOCKER COMPOSE VARIABLES
# ============================================================================
# DB_NAME=pdf_ia_rework_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres123
# POSTGRES_PORT=5432

