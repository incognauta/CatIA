# ============================================================================
# Frontend Environment Variables Template
# Copy this file to .env.local and fill in with your actual values
# NEVER commit the actual .env file - it may contain sensitive data
# ============================================================================

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Backend API URL - Must match backend running instance
# Development (local): http://localhost:8001
# Development (Docker): http://localhost:8000
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8001/api/v1

# Note: This is NOT a secret - it's just the backend URL
# Frontend apps expose VITE_ variables to the client bundle

# ============================================================================
# AUTHENTICATION
# ============================================================================
# LocalStorage key for JWT token (usually doesn't need changing)
VITE_JWT_STORAGE_KEY=auth_token

# ============================================================================
# APP CONFIGURATION (Optional)
# ============================================================================
# App name and logo URLs
VITE_APP_NAME=PDF_IA
VITE_APP_VERSION=0.0.1

# ============================================================================
# DEBUG MODE
# ============================================================================
# Set to true for development debugging
# Note: This exposes more detailed error messages
VITE_DEBUG=true

